# Local-checkout adapter: dependencies, versioning and installation are owned by
# packaging/aur. Run makepkg in this directory, with BUILDDIR/PKGDEST on disk.
source "$(dirname "${BASH_SOURCE[0]}")/../../../packaging/aur/atmosphera-git/PKGBUILD"

# makepkg rewrites these assignments after pkgver(), then sources this file
# again. Keep the computed values instead of reloading the canonical seeds.
pkgver=$pkgver
pkgrel=$pkgrel

_ref="${ATMOSPHERA_REF:-main}"
source=("atmosphera::git+file://${ATMOSPHERA_CHECKOUT:-/mnt/hostshare}#branch=${_ref}")
