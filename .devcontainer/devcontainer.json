{
  "name": "Atmosphera Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "runArgs": [
    "--memory=12g",
    "--memory-swap=12g",
    "--pids-limit=2048",
    "--cpus=12"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "bierner.qml",
        "ms-python.python",
        "timonwong.shellcheck",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "files.associations": {
          "*.qml": "qml"
        }
      }
    }
  },
  "remoteUser": "dev"
}
