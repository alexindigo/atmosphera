#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

STAGED_QML=$(git diff --cached --name-only --diff-filter=ACM | grep '\.qml$' || true)

if [ -n "$STAGED_QML" ]; then
  if ! command -v docker &>/dev/null; then
    echo "docker not found — required for pre-commit checks." >&2
    echo "Install docker, or bypass with 'git commit --no-verify'." >&2
    exit 1
  fi

  IMAGE="atmosphera-dev:local"
  if ! docker image inspect "$IMAGE" &>/dev/null; then
    echo "Building $IMAGE (first run only)..." >&2
    docker build -t "$IMAGE" .devcontainer >&2
  fi

  mapfile -t files <<< "$STAGED_QML"

  # Capture output into a variable rather than piping directly to git's
  # stdout/stderr — a filled pipe buffer from docker's output can stall
  # git's commit pipeline. Only print the output on failure.
  hook_output=$(docker run --rm \
    --user "$(id -u):$(id -g)" \
    --cap-add SYS_ADMIN \
    --tmpfs /tmp/overlay:size=256m,mode=1777 \
    --memory=12g \
    --memory-swap=12g \
    --pids-limit=2048 \
    --cpus=12 \
    -v "$REPO_ROOT:/workspaces/atmosphera" \
    -w /workspaces/atmosphera \
    "$IMAGE" \
    atmo-dev .devcontainer/precommit-check.sh "${files[@]}" 2>&1) && hook_ec=0 || hook_ec=$?
  if [ $hook_ec -ne 0 ]; then
    echo "$hook_output" >&2
    exit 1
  fi

  git update-index --again
fi

# -- Settings search index (unchanged, still runs on host) --
if git diff --cached --name-only --diff-filter=ACM | grep -q 'Assets/Translations/.*\.json\|Commons/Settings\.qml'; then
  python3 Scripts/dev/build-settings-search-index.py
  git add Assets/settings-search-index.json
fi

# -- Defaults freshness reminder --
# Configs/defaults.json is generated from the Settings.qml adapter schema by a
# dev shell running with ATMOSPHERA_DEBUG=1. If the schema region changed
# (property lines in the JsonAdapter), the file should be regenerated and
# staged alongside. Logic-only edits don't need it, so this is a warning.
if git diff --cached --name-only --diff-filter=ACM | grep -q 'Commons/Settings\.qml'; then
  if ! git diff --cached --name-only --diff-filter=ACM | grep -q 'Configs/defaults\.json'; then
    if git diff --cached -- Commons/Settings.qml | grep -qE '^\+[[:space:]]*(readonly )?property (JsonObject|var|bool|int|string|real|color) '; then
      echo "WARNING: Settings.qml schema changed but Configs/defaults.json is not staged." >&2
      echo "  Regenerate with a debug shell run (ATMOSPHERA_DEBUG=1) and stage it," >&2
      echo "  or ignore if the property change is not part of the settings schema." >&2
    fi
  fi
fi
