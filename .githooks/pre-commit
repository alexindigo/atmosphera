#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO_ROOT"

STAGED_QML=$(git diff --cached --name-only --diff-filter=ACM | grep '\.qml$' || true)

if [ -n "$STAGED_QML" ]; then
  if ! command -v docker &>/dev/null; then
    echo "docker not found — required for pre-commit checks." >&2
    echo "Install docker, or bypass with 'git commit --no-verify'." >&2
    exit 1
  fi

  IMAGE="atmosphera-dev:local"
  if ! docker image inspect "$IMAGE" &>/dev/null; then
    echo "Building $IMAGE (first run only)..." >&2
    docker build -t "$IMAGE" .devcontainer >&2
  fi

  mapfile -t files <<< "$STAGED_QML"

  docker run --rm \
    --user "$(id -u):$(id -g)" \
    -v "$REPO_ROOT:$REPO_ROOT" \
    -w "$REPO_ROOT" \
    "$IMAGE" \
    .devcontainer/precommit-check.sh "${files[@]}"

  git update-index --again
fi

# -- Settings search index (unchanged, still runs on host) --
if git diff --cached --name-only --diff-filter=ACM | grep -q 'Assets/Translations/.*\.json\|Commons/Settings\.qml'; then
  python3 Scripts/dev/build-settings-search-index.py
  git add Assets/settings-search-index.json
fi
