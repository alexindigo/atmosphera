// Shared plugin loader core probe (shared-loader design, L03). Runs as the qs
// entry of a disposable shell copy made by plugin-loader-regression.py --case
// core. The original contract fixtures plus an S3 failure matrix; failing
// entry files are generated by the runner only in its disposable copy.
import QtQuick
import Quickshell
import qs.Services.Plugins

Item {
  id: probe

  property int _polls: 0
  readonly property var screenRef: Quickshell.screens.length > 0 ? Quickshell.screens[0] : null
  readonly property var ctx: ({
                                "screen": probe.screenRef
                              })
  readonly property var views: [viewDeclares, viewBare, viewInherits, viewBroken]
  // Plugins live outside the Quickshell VFS (file:// urls); load fixtures the same way.
  readonly property string fixtureRoot: "file://" + Quickshell.shellDir + "/Scripts/dev/fixtures/plugin-loader/"

  QtObject {
    id: fakeApi

    property string pluginId: "probe"
  }

  PluginView {
    id: viewDeclares

    pluginKey: "fx-declares"
    entryPoint: "panel"
    url: probe.fixtureRoot + "fx-declares/Panel.qml"
    api: fakeApi
    context: probe.ctx
  }

  PluginView {
    id: viewBare

    pluginKey: "fx-bare"
    entryPoint: "panel"
    url: probe.fixtureRoot + "fx-bare/Panel.qml"
    api: fakeApi
    context: probe.ctx
  }

  PluginView {
    id: viewInherits

    pluginKey: "fx-inherits"
    entryPoint: "panel"
    url: probe.fixtureRoot + "fx-inherits/Panel.qml"
    api: fakeApi
    context: probe.ctx
  }

  PluginView {
    id: viewBroken

    pluginKey: "fx-broken"
    entryPoint: "panel"
    url: probe.fixtureRoot + "fx-broken/Panel.qml"
    api: fakeApi
    context: probe.ctx
  }

  // S3 failure matrix: compile, incubation, missing file, no component, and
  // an explicit unload after failure. Files with errors are generated only in
  // the runner's disposable copy.
  PluginView {
    id: viewCreationFailure
    pluginKey: "s3-view-create"
    entryPoint: "panel"
    url: probe.fixtureRoot + "fx-creation-failure/Panel.qml"
    api: fakeApi
  }

  PluginView {
    id: viewMissing
    pluginKey: "s3-view-missing"
    entryPoint: "panel"
    url: probe.fixtureRoot + "fx-missing/Panel.qml"
    api: fakeApi
  }

  PluginView {
    id: viewCleared
    pluginKey: "s3-view-cleared"
    entryPoint: "panel"
    url: probe.fixtureRoot + "fx-creation-failure/Panel.qml"
    api: fakeApi
    onFailedChanged: if (failed) Qt.callLater(function () { viewCleared.url = ""; })
  }

  property var directResults: ({})

  Component.onCompleted: {
    var creation = Qt.createComponent(probe.fixtureRoot + "fx-creation-failure/Panel.qml");
    var broken = Qt.createComponent(probe.fixtureRoot + "fx-broken/Panel.qml");
    directResults = {
      "creation": PluginLoader.createObject("s3-direct-create", "main", creation, probe, fakeApi, {}) === null,
      "compile": PluginLoader.createObject("s3-direct-compile", "main", broken, probe, fakeApi, {}) === null,
      "missing": PluginLoader.createObject("s3-direct-null", "main", null, probe, fakeApi, {}) === null
    };
    PluginLoader.recordLoadFailure("s3-empty-report", "panel", null, "");
  }

  function report(settled) {
    var rows = [];
    for (var i = 0; i < probe.views.length; i++) {
      var v = probe.views[i];
      var piece = v.item;
      rows.push({
                  "key": v.pluginKey,
                  "loaded": piece !== null && piece !== undefined,
                  "failed": v.failed,
                  "placeholder": v.placeholder.visible && v.placeholder.width > 0,
                  "screen": (piece && piece.screen) ? piece.screen.name : null,
                  "pluginApi": !!piece && piece.pluginApi === fakeApi
                });
    }
    var errors = [];
    var failureErrors = {};
    for (var key in Service.pluginErrors) {
      if (key.indexOf("s3-") === 0)
        failureErrors[key] = Service.pluginErrors[key];
      else
        errors.push([key, Service.pluginErrors[key].entryPoint]);
    }
    errors.sort();
    console.log("PLUGIN_LOADER|SCREEN|" + JSON.stringify(probe.screenRef ? probe.screenRef.name : null));
    console.log("PLUGIN_LOADER|VIEWS|" + JSON.stringify(rows));
    console.log("PLUGIN_LOADER|ERRORS|" + JSON.stringify(errors));
    console.log("PLUGIN_LOADER|FAILURES|" + JSON.stringify({
      "errors": failureErrors,
      "direct": directResults,
      "creationFailed": viewCreationFailure.failed && !viewCreationFailure.item && viewCreationFailure.placeholder.visible,
      "missingFailed": viewMissing.failed && !viewMissing.item && viewMissing.placeholder.visible,
      "cleared": viewCleared.url === "" && !viewCleared.failed && !viewCleared.item
    }));
    console.log("PLUGIN_LOADER|DONE|" + (settled ? "settled" : "timeout"));
    Qt.exit(settled ? 0 : 2);
  }

  Timer {
    id: pollTimer

    interval: 200
    repeat: true
    running: true
    onTriggered: {
      probe._polls++;
      var settled = true;
      for (var i = 0; i < probe.views.length; i++) {
        var v = probe.views[i];
        if (!v.item && !v.failed)
          settled = false;
      }
      if (!viewCreationFailure.failed || !viewMissing.failed || viewCleared.url !== "")
        settled = false;
      if (settled || probe._polls > 100) {
        pollTimer.stop();
        probe.report(settled);
      }
    }
  }
}
