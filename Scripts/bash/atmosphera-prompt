#!/bin/bash
set -euo pipefail

question="${1:?Usage: atmosphera-prompt <question> [default]}"
default="${2:-}"
[ "$default" = "-" ] && default=""

QS="${ATMOSPHERA_QS:-qs}"

source "$(dirname "$(readlink -f "$0")")/shell-owner.sh"
PID=$(shell_owner_require)

source "$(dirname "$(readlink -f "$0")")/dialog-reply.sh"
dialog_request prompt "$question" "$default"
dialog_read || {
  echo ""
  exit 0
}
echo "${result:-}"
