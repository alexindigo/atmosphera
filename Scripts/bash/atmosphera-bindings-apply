#!/usr/bin/env bash
# atmosphera-bindings-apply
# Deploy per-environment shortcut configs to the user's system.
#
# Reads Settings.data.bindings.environment from
# ~/.config/atmosphera/settings.json and applies the corresponding files
# from <shellDir>/Bindings/environments/<env>/.
#
# Non-root operations only. keyd-side changes require sudo and are
# performed by atmosphera-bindings-apply-keyd (or the NixOS module).

set -euo pipefail

SETTINGS_FILE="${ATMOSPHERA_SETTINGS_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/atmosphera/settings.json}"

# Resolve shell directory (the checkout or install path).
if [ -n "${ATMOSPHERA_SHELL_DIR:-}" ]; then
  SHELL_DIR="$ATMOSPHERA_SHELL_DIR"
else
  # Script lives in <shellDir>/Scripts/bash/; walk two levels up.
  SCRIPT_PATH="$(readlink -f "$0")"
  SHELL_DIR="$(dirname "$(dirname "$(dirname "$SCRIPT_PATH")")")"
fi

BINDINGS_DIR="$SHELL_DIR/Bindings"

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
NIRI_DIR="$CONFIG_HOME/niri"
XREMAP_DIR="$CONFIG_HOME/xremap"
ZED_DIR="$CONFIG_HOME/zed"

log() { printf '[bindings-apply] %s\n' "$*" >&2; }

read_environment() {
  # Per-panel layout: settings/bindings.json takes precedence; the legacy
  # monolith (settings.json) is the fallback layer.
  local section_file="$(dirname "$SETTINGS_FILE")/settings/bindings.json"
  python3 -c "
import json,sys
for path in sys.argv[1:]:
    try:
        with open(path) as f:
            d = json.load(f)
        env = d.get('environment') if path.endswith('bindings.json') else d.get('bindings', {}).get('environment')
        if isinstance(env, str) and env:
            print(env)
            break
    except Exception:
        continue
else:
    print('none')
 " "$section_file" "$SETTINGS_FILE"
}

apply_xremap() {
  local operation="$1" load active
  if ! command -v systemctl >/dev/null 2>&1; then
    log "not-applicable: systemd user manager tooling is absent"
    return 0
  fi
  load="$(systemctl --user show xremap-atmosphera.service -p LoadState --value)" || return 1
  if [ "$load" = "not-found" ]; then
    log "not-applicable: xremap-atmosphera.service is absent"
    return 0
  fi
  active="$(systemctl --user show xremap-atmosphera.service -p ActiveState --value)" || return 1
  if [ "$operation" = "stop" ] && [ "$active" = "inactive" ]; then
    log "not-applicable: xremap is already inactive"
    return 0
  fi
  systemctl --user "$operation" xremap-atmosphera.service || return 1
  active="$(systemctl --user show xremap-atmosphera.service -p ActiveState --value)" || return 1
  if [ "$operation" = "restart" ] && [ "$active" != "active" ]; then
    log "xremap start did not reach active state; check the user-manager XDG configuration path"
    return 1
  fi
  if [ "$operation" = "stop" ] && [ "$active" != "inactive" ]; then
    log "xremap stop did not reach inactive state"
    return 1
  fi
}

apply_keyd_layer() {
  local source="$1"
  if [ ! -e /etc/keyd/atmosphera ] && [ ! -L /etc/keyd/atmosphera ]; then
    log "not-applicable: managed keyd layer is absent"
    return 0
  fi
  [ -w /etc/keyd/atmosphera ] || { log "managed keyd layer is not writable"; return 1; }
  awk '/^\[ids\]/{skip=1; next} /^\[/{skip=0} !skip' "$source" > /etc/keyd/atmosphera || return 1
  if [ ! -e /var/run/keyd.socket ]; then
    log "not-applicable: keyd daemon is inactive; managed file write completed"
    return 0
  fi
  # systemctl waits for the existing polkit-authorized systemd job, unlike a
  # StartUnit acknowledgement. Its failure is an application-stage failure.
  systemctl start atmosphera-keyd-reload.service || return 1
}

backup_if_exists() {
  local file="$1"
  [ -e "$file" ] || return 0
  [ -L "$file" ] && return 0            # symlink, no backup
  local backup="${file}.pre-atmosphera"
  [ -e "$backup" ] && return 0          # already backed up
  cp -a "$file" "$backup"
  log "backed up existing $file to $backup"
}

apply_macos() {
  local env_dir="$BINDINGS_DIR/environments/macos"
  [ -d "$env_dir" ] || { log "environment dir missing: $env_dir"; exit 1; }

  # niri — deploy the shortcuts layer; the session config picks it up
  # (composed + activated by NiriSessionInit in the running shell, or on
  # next shell start). We never touch the user's config.kdl.
  mkdir -p "$NIRI_DIR"
  install -m 0644 "$env_dir/niri/atmosphera-shortcuts-macos.kdl" \
    "$NIRI_DIR/atmosphera-shortcuts-macos.kdl"
  log "deployed niri: atmosphera-shortcuts-macos.kdl"

  # xremap — deploy config; the running shell starts/restarts the user
  # service via the systemd user manager (XremapService). CLI fallback
  # for the shell-off case: restart it directly (user units need no root).
  mkdir -p "$XREMAP_DIR"
  install -m 0644 "$env_dir/xremap/atmosphera-xremap.yml" \
    "$XREMAP_DIR/atmosphera-xremap.yml"
  log "deployed xremap: atmosphera-xremap.yml"
  apply_xremap restart

  # zed
  mkdir -p "$ZED_DIR"
  backup_if_exists "$ZED_DIR/keymap.json"
  install -m 0644 "$env_dir/zed/keymap.json" "$ZED_DIR/keymap.json"
  log "deployed zed: keymap.json"

  # keyd: write the user-owned managed layer. The running shell normally does
  # this in-process (KeydService writes + triggers reload via systemd D-Bus);
  # this CLI path covers the shell-not-running case. Reload goes through the
  # atmosphera-keyd-reload service (polkit rule allows it without sudo).
  apply_keyd_layer "$env_dir/keyd/default.conf"

}

apply_none() {
  # niri: the shortcuts layer file is left in place but drops out of the
  # composed session config (NiriSessionInit regenerates without it when
  # the environment is "none").

  # keyd → revert to neutral stub (user-owned managed layer, no root needed)
  local stub="$BINDINGS_DIR/environments/macos/keyd/atmosphera.stub"
  apply_keyd_layer "$stub"

  # xremap: stop the user service (config left in place — inert without it);
  # zed keymap left in place (inert without the editor loading it).
  apply_xremap stop
}

main() {
  local env
  if [ "$#" -eq 0 ]; then
    env="$(read_environment)"
  elif [ "$#" -eq 2 ] && [ "$1" = "--environment" ]; then
    env="$2"
  else
    log "usage: atmosphera bindings apply [--environment none|macos]"
    return 2
  fi
  case "$CONFIG_HOME" in /*) ;; *) log "XDG_CONFIG_HOME must be absolute"; return 2 ;; esac
  log "environment: $env"
  case "$env" in
    macos) apply_macos ;;
    none)  apply_none  ;;
    *)     log "unknown environment: $env (expected: none|macos)"; exit 2 ;;
  esac
  log "done."
}

main "$@"
