#!/bin/bash
set -euo pipefail

[ $# -ge 2 ] || { echo "Usage: atmosphera-survey [<title>] <name1> <value1> [name2 value2] ..." >&2; exit 1; }

title=""
if [ $(( $# % 2 )) -eq 1 ]; then
  title="$1"; shift
fi

# Build JSON array from remaining args (name value pairs)
json="["
sep=""
while [ $# -ge 2 ]; do
  name="$1"; value="$2"; shift 2
  name_esc=$(printf '%s' "$name" | sed 's/[\\"]/\\&/g')
  [ "$value" = "-" ] && value=""
  value_esc=$(printf '%s' "$value" | sed 's/[\\"]/\\&/g')
  json="${json}${sep}{\"label\":\"${name_esc}\",\"default\":\"${value_esc}\"}"
  sep=","
done
json="${json}]"

QS="${ATMOSPHERA_QS:-qs}"

source "$(dirname "$(readlink -f "$0")")/shell-owner.sh"
PID=$(shell_owner_require)

source "$(dirname "$(readlink -f "$0")")/dialog-reply.sh"
b64=$(printf '%s' "$json" | base64 -w0)
dialog_request survey "$title" "$b64"
dialog_read || {
  echo ""
  exit 0
}
echo "${result:-}"
