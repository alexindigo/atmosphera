#!/bin/bash
set -euo pipefail

[ $# -ge 2 ] || { echo "Usage: atmosphera-survey [<title>] <name1> <value1> [name2 value2] ..." >&2; exit 1; }

title=""
if [ $(( $# % 2 )) -eq 1 ]; then
  title="$1"; shift
fi

# Build JSON array from remaining args (name value pairs)
json="["
sep=""
while [ $# -ge 2 ]; do
  name="$1"; value="$2"; shift 2
  name_esc=$(printf '%s' "$name" | sed 's/[\\"]/\\&/g')
  [ "$value" = "-" ] && value=""
  value_esc=$(printf '%s' "$value" | sed 's/[\\"]/\\&/g')
  json="${json}${sep}{\"label\":\"${name_esc}\",\"default\":\"${value_esc}\"}"
  sep=","
done
json="${json}]"

QS="${ATMOSPHERA_QS:-qs}"

find_config() {
  [ -n "${ATMOSPHERA_CONFIG:-}" ] && { echo "$ATMOSPHERA_CONFIG"; return 0; }
  [ -d "$HOME/Projects/atmosphera" ] && { echo "$HOME/Projects/atmosphera"; return 0; }
  echo "/etc/xdg/quickshell/atmosphera"
}
CONFIG="$(find_config)"

tmpdir=$(mktemp -d "${XDG_RUNTIME_DIR:-/dev/shm}/atmosphera-dialog-XXXXXX")
fifo="$tmpdir/reply"
mkfifo "$fifo"

cleanup() {
  $QS ipc -p "$CONFIG" call dialog cancel &>/dev/null || true
  rm -rf "$tmpdir"
}
trap cleanup EXIT INT TERM

b64=$(printf '%s' "$json" | base64 -w0)
$QS ipc -p "$CONFIG" call dialog survey "$title" "$b64" "$fifo" &>/dev/null &

TIMEOUT="${ATMOSPHERA_DIALOG_TIMEOUT:-30}"
read -t "$TIMEOUT" result < "$fifo" 2>/dev/null || {
  $QS ipc -p "$CONFIG" call dialog cancel &>/dev/null || true
  echo ""
  exit 0
}
echo "${result:-}"
