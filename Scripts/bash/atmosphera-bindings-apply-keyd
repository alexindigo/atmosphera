#!/usr/bin/env bash
# atmosphera-bindings-apply-keyd <environment>
# Root-side keyd bootstrap for atmosphera bindings.
#
# environment: none | macos   (default: read from settings.json)
#
# Idempotent. Writes:
#   /etc/keyd/default.conf   -- stub with 'include atmosphera' (only if absent)
#   /etc/keyd/atmosphera     -- neutral stub OR environment's default.conf
# Then reloads keyd if it's running.

set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
  echo "atmosphera-bindings-apply-keyd must run as root (try: sudo $0 $*)" >&2
  exit 1
fi

if [ -n "${ATMOSPHERA_SHELL_DIR:-}" ]; then
  SHELL_DIR="$ATMOSPHERA_SHELL_DIR"
else
  SCRIPT_PATH="$(readlink -f "$0")"
  SHELL_DIR="$(dirname "$(dirname "$(dirname "$SCRIPT_PATH")")")"
fi

BINDINGS_DIR="$SHELL_DIR/Bindings"
KEYD_DIR="/etc/keyd"
KEYD_MAIN="$KEYD_DIR/default.conf"
KEYD_INCLUDE="$KEYD_DIR/atmosphera"

ENV_NAME="${1:-}"
if [ -z "$ENV_NAME" ]; then
  # Read from the invoking user's settings (per-panel file first, legacy
  # monolith as fallback layer)
  SETTINGS_USER="${SUDO_USER:-$USER}"
  SETTINGS_HOME="$(getent passwd "$SETTINGS_USER" | cut -d: -f6)"
  SECTION_FILE="$SETTINGS_HOME/.config/atmosphera/settings/bindings.json"
  SETTINGS_FILE="$SETTINGS_HOME/.config/atmosphera/settings.json"
  ENV_NAME="$(python3 -c "
import json
for path in ('$SECTION_FILE', '$SETTINGS_FILE'):
    try:
        with open(path) as f:
            d = json.load(f)
        env = d.get('environment') if path.endswith('bindings.json') else d.get('bindings', {}).get('environment')
        if isinstance(env, str) and env:
            print(env)
            break
    except Exception:
        continue
else:
    print('none')
")"
fi

log() { printf '[bindings-apply-keyd] %s\n' "$*" >&2; }

mkdir -p "$KEYD_DIR"

# 1. Ensure /etc/keyd/default.conf exists with our include, scoped to the
#    environment's device ids — never a wildcard, so the Mac rotation does
#    not leak onto external keyboards.
if [ ! -f "$KEYD_MAIN" ]; then
  IDS="$(awk '/^\[ids\]/{f=1;next} /^\[/{f=0} f && /^[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]:/ {print}' \
        "$BINDINGS_DIR/environments/macos/keyd/default.conf" 2>/dev/null)"
  [ -n "$IDS" ] || IDS="0001:0001"
  {
    echo "# Written by atmosphera-bindings-apply-keyd"
    echo "# Extend by editing this file. The 'atmosphera' include is managed separately."
    echo "[ids]"
    echo "$IDS"
    echo ""
    echo "[main]"
    echo "include atmosphera"
  } > "$KEYD_MAIN"
  chmod 0644 "$KEYD_MAIN"
  log "created $KEYD_MAIN (scoped to: $(echo "$IDS" | tr '\n' ' '))"
elif ! grep -qE '^\s*include\s+atmosphera\s*$' "$KEYD_MAIN"; then
  log "WARNING: $KEYD_MAIN exists but does not include atmosphera"
  log "add this line under [main] to activate the atmosphera environment:"
  log "    include atmosphera"
fi

# 2. Write the include target based on environment, then hand it to the
#    invoking user so future `atmosphera bindings apply` runs need no root.
case "$ENV_NAME" in
  macos)
    # [ids] stripped: the include target must not carry one (keyd include
    # limitation — it silently kills the mapping).
    awk '/^\[ids\]/{skip=1; next} /^\[/{skip=0} !skip' "$BINDINGS_DIR/environments/macos/keyd/default.conf" > "$KEYD_INCLUDE"
    chmod 0644 "$KEYD_INCLUDE"
    log "wrote $KEYD_INCLUDE from environments/macos/keyd/default.conf (ids stripped)"
    ;;
  none|"")
    install -m 0644 "$BINDINGS_DIR/environments/macos/keyd/atmosphera.stub" "$KEYD_INCLUDE"
    log "wrote $KEYD_INCLUDE as neutral stub"
    ;;
  *)
    log "unknown environment: $ENV_NAME"
    exit 2
    ;;
esac
if [ -n "${SUDO_USER:-}" ]; then
  chown "$SUDO_USER" "$KEYD_INCLUDE" 2>/dev/null && log "handed $KEYD_INCLUDE to $SUDO_USER" || true
fi

# 3. Reload keyd if active
if command -v keyd >/dev/null 2>&1 && systemctl is-active --quiet keyd 2>/dev/null; then
  keyd reload && log "keyd reloaded"
else
  log "keyd not active — run 'systemctl enable --now keyd' to activate"
fi

log "done."
