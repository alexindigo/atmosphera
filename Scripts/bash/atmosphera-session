#!/usr/bin/env -S bash
set -euo pipefail

# Shell version switcher.
# Kills current shell and launches a different one — windows stay open.

QS_BIN="qs"
SELF_DIR="$(dirname "$(readlink -f "$0")")"
source "$SELF_DIR/shell-owner.sh"

declare -A SHELLS
SHELLS["atmosphera"]="/etc/xdg/quickshell/atmosphera"

list() {
  echo "Available shells:"
  for name in "${!SHELLS[@]}"; do
    printf "  %-20s %s\n" "$name" "${SHELLS[$name]}"
  done
  echo ""
  echo "Any directory path also works: launch ~/path/to/shell"
}

launch() {
  local target="${1:-}"
  [ -z "$target" ] && { echo "Usage: $0 launch <name|path>" >&2; list; exit 1; }

  # If it's a known name, resolve to path; otherwise treat as a direct path
  if [ -n "${SHELLS[$target]:-}" ]; then
    target="${SHELLS[$target]}"
  elif [ ! -d "$target" ]; then
    echo "Unknown shell and not a valid directory: $target" >&2
    list
    exit 1
  fi

  # Leaving atmosphera → restore niri's boot-time base config
  if [ "${SHELLS[atmosphera]}" != "$target" ] && ! grep -q '^//@ pragma ShellId app\.atmosphera\.Shell$' "$target/shell.qml" && [ -n "${NIRI_SOCKET:-}" ]; then
    local session_file="${XDG_CONFIG_HOME:-$HOME/.config}/niri/atmosphera-session.kdl"
    if [ -f "$session_file" ]; then
      local marker base=""
      marker=$(grep -m1 '^// Base config detected at niri boot: ' "$session_file" || true)
      base="${marker#// Base config detected at niri boot: }"
      if [ -n "$base" ] && [ -f "$base" ]; then
        niri msg action load-config-file --path "$base" 2>/dev/null \
          && echo "Restored niri config: $base" || true
      fi
    fi
  fi

  echo "Launching: $target"
  shell_owner_stop
  exec "$QS_BIN" -n -p "$target" -d
}

stop() {
  shell_owner_stop
  echo "Shell stopped."
}

case "${1:-}" in
  list) list ;;
  launch) launch "${2:-}" ;;
  stop) stop ;;
  *) echo "Usage: $0 list|launch <name|path>|stop" >&2; list; exit 1 ;;
esac
