#!/usr/bin/env bash
set -euo pipefail

# atmosphera-niri-setup
# Installs Atmosphera's niri layer and composes the session config
# (~/.config/niri/atmosphera-session.kdl) that includes the user's base
# config plus atmosphera layers, then switches the running niri to it.
# Never modifies the user's config.kdl (except stripping our legacy
# include line, if present — reversing the old behavior).

NIRI_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/niri"
CONFIG_FILE="${NIRI_DIR}/config.kdl"
SESSION_FILE="${NIRI_DIR}/atmosphera-session.kdl"
SETTINGS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/atmosphera/settings.json"
LEGACY_INCLUDE='include "atmosphera.kdl"'

# Resolve shell dir (install tree or dev checkout): Scripts/bash/<this>
SCRIPT_PATH="$(readlink -f "$0")"
SHELL_DIR="$(dirname "$(dirname "$(dirname "$SCRIPT_PATH")")")"
ATMOSPHERA_KDL_SRC="${SHELL_DIR}/Configs/niri/atmosphera.kdl"
ATMOSPHERA_I18N_SRC="${SHELL_DIR}/Configs/niri/atmosphera-i18n.kdl"

mkdir -p "$NIRI_DIR"

# Refresh the baseline layer (user explicitly invoked setup)
install -m 0644 "$ATMOSPHERA_KDL_SRC" "${NIRI_DIR}/atmosphera.kdl"
install -m 0644 "$ATMOSPHERA_I18N_SRC" "${NIRI_DIR}/atmosphera-i18n.kdl"
echo "Installed: ${NIRI_DIR}/atmosphera.kdl"

# --- Startup route: systemd unit vs compositor spawn ---
# Systemd route (DMS pattern): the shell runs as a supervised user service
# wanted by niri.service; the compositor spawn line is dropped from the
# layer. Non-systemd sessions keep the spawn line (baseline behavior).
SYSTEMD_ROUTE=false
if command -v systemctl >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
  if [ "$(systemctl --user show -p LoadState --value niri.service 2>/dev/null)" != "not-found" ] \
     && [ "$(systemctl --user show -p LoadState --value atmosphera.service 2>/dev/null)" != "not-found" ]; then
    SYSTEMD_ROUTE=true
  fi
fi

if [ "$SYSTEMD_ROUTE" = true ]; then
  sed -i '/^spawn-at-startup "qs" "-n" "-c" "atmosphera"$/d' "${NIRI_DIR}/atmosphera.kdl"
  systemctl --user add-wants niri.service atmosphera.service
  echo "Systemd route: shell supervised via niri.service -> atmosphera.service"
else
  # Drop a stale wants link from a previous systemd-route setup, if any
  if [ "$(systemctl --user show -p LoadState --value atmosphera.service 2>/dev/null || true)" != "not-found" ]; then
    systemctl --user disable atmosphera.service >/dev/null 2>&1 || true
  fi
  echo "Spawn route: shell started by niri's spawn-at-startup"
fi

# Strip legacy include from the user's config (exact-match reversal)
if [ -f "$CONFIG_FILE" ] && grep -qxF "$LEGACY_INCLUDE" "$CONFIG_FILE"; then
  sed -i '/^include "atmosphera.kdl"$/d' "$CONFIG_FILE"
  echo "Removed legacy include from: ${CONFIG_FILE}"
fi

# Bindings environment (same source as atmosphera-bindings-apply):
# per-panel settings/bindings.json first, legacy settings.json as fallback
SECTION_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/atmosphera/settings/bindings.json"
env_val=$(python3 -c "
import json
for path in ('$SECTION_FILE', '$SETTINGS_FILE'):
    try:
        with open(path) as f:
            d = json.load(f)
        env = d.get('environment') if path.endswith('bindings.json') else d.get('bindings', {}).get('environment')
        if isinstance(env, str) and env:
            print(env)
            break
    except Exception:
        continue
else:
    print('none')
")

# Detect niri's boot-time base config from the process hosting this session
# (cmdline/environ are frozen at exec time — immune to later config switches)
BASE=""
if [ -n "${NIRI_SOCKET:-}" ]; then
  # /proc/net/unix maps socket path → kernel socket inode (the fs inode of
  # the socket file is a different namespace — do not stat the file).
  INODE=$(awk -v p="$NIRI_SOCKET" '$NF == p {print $7; exit}' /proc/net/unix 2>/dev/null || true)
  PID=""
  if [ -n "$INODE" ]; then
    for fd_dir in /proc/[0-9]*/fd; do
      if ls -l "$fd_dir" 2>/dev/null | grep -q "socket:\[$INODE\]"; then
        PID="${fd_dir#/proc/}"; PID="${PID%/fd}"
        break
      fi
    done
  fi
  if [ -n "$PID" ]; then
    BASE=$(tr '\0' '\n' < "/proc/$PID/cmdline" 2>/dev/null \
      | awk '/^(-c|--config)$/{getline; print; exit} /^--config=/{sub(/^--config=/,""); print; exit}' || true)
    if [ -z "$BASE" ]; then
      BASE=$(tr '\0' '\n' < "/proc/$PID/environ" 2>/dev/null | sed -n 's/^NIRI_CONFIG=//p' | head -1 || true)
    fi
  fi
fi
[ -n "$BASE" ] || BASE="$CONFIG_FILE"

# Compose the session config
{
  echo "// Generated by Atmosphera. Do not edit — regenerated on shell start."
  echo "// Base config detected at niri boot: $BASE"
  if [ -f "$BASE" ]; then
    if [ "$(dirname "$BASE")" = "$NIRI_DIR" ]; then
      echo "include \"$(basename "$BASE")\""
    else
      echo "include \"$BASE\""
    fi
  fi
  echo 'include "atmosphera.kdl"'
  echo 'include "atmosphera-i18n.kdl"'
  if [ "$env_val" = "macos" ] && [ -f "${NIRI_DIR}/atmosphera-shortcuts-macos.kdl" ]; then
    echo 'include "atmosphera-shortcuts-macos.kdl"'
  fi
} > "$SESSION_FILE"
echo "Composed: ${SESSION_FILE}"

# Activate on the running niri, if any
if [ -n "${NIRI_SOCKET:-}" ] && command -v niri >/dev/null 2>&1; then
  if niri msg action load-config-file --path "$SESSION_FILE" 2>/dev/null; then
    echo "Activated session config on the running niri."
  else
    echo "Note: could not activate on the running niri (will apply on next shell start)."
  fi
else
  echo "niri not running — session config applies when the shell next starts under niri."
fi

if [ "$SYSTEMD_ROUTE" = true ]; then
  echo "Boot note: the shell starts via systemd (niri.service wants"
  echo "atmosphera.service). No niri config changes needed."
else
  echo "Boot note: ensure your niri startup launches the shell, e.g."
  echo '  spawn-at-startup "qs" "-n" "-c" "atmosphera"'
  echo "in your own config.kdl (atmosphera never modifies it)."
fi
