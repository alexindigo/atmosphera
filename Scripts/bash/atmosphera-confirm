#!/bin/bash
set -euo pipefail

question="${1:?Usage: atmosphera-confirm <question>}"

fifo=$(mktemp -u /dev/shm/atmosphera-confirm-XXXXXXXX)
mkfifo "$fifo"

QS="${ATMOSPHERA_QS:-qs}"

find_config() {
  [ -n "${ATMOSPHERA_CONFIG:-}" ] && { echo "$ATMOSPHERA_CONFIG"; return 0; }
  [ -d "$HOME/Projects/atmosphera" ] && { echo "$HOME/Projects/atmosphera"; return 0; }
  echo "/etc/xdg/quickshell/atmosphera"
}
CONFIG="$(find_config)"

cleanup() {
  $QS ipc -p "$CONFIG" call dialog cancel &>/dev/null || true
}
trap cleanup EXIT INT TERM

$QS ipc -p "$CONFIG" call dialog confirm "$question" "$fifo" &>/dev/null &

read -t 86400 result < "$fifo" 2>/dev/null || true
rm -f "$fifo" 2>/dev/null || true
[ "${result:-}" = "true" ]
