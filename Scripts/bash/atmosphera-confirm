#!/bin/bash
set -euo pipefail

question="${1:?Usage: atmosphera-confirm <question>}"

QS="${ATMOSPHERA_QS:-qs}"

source "$(dirname "$(readlink -f "$0")")/shell-owner.sh"
PID=$(shell_owner_require)

source "$(dirname "$(readlink -f "$0")")/dialog-reply.sh"
dialog_request confirm "$question"
dialog_read || exit 1
[ "${result:-}" = "true" ]
