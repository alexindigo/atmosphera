#!/usr/bin/env -S bash
set -euo pipefail

QS_BIN="qs"

source "$(dirname "$(readlink -f "$0")")/shell-owner.sh"

ACTION="${1:-lock}"

usage() {
  echo "Usage: $0 [lock|preview|help]"
  echo ""
  echo "Commands:"
  echo "  lock      Lock the screen (default)"
  echo "  preview   Open lock screen in preview mode"
  echo "  help      Show this help"
  echo ""
  echo "Examples:"
  echo "  $0           # Lock the screen"
  echo "  $0 lock      # Lock the screen"
  echo "  $0 preview   # Preview lock screen"
}

case "$ACTION" in
  help|--help|-h) usage; exit 0 ;;
  lock)     PID=$(shell_owner_require); exec timeout 5 "$QS_BIN" ipc --pid "$PID" call lockScreen lock ;;
  preview)  PID=$(shell_owner_require); exec timeout 5 "$QS_BIN" ipc --pid "$PID" call lockScreen preview ;;
  *)        echo "Unknown action: $ACTION"; usage; exit 1 ;;
esac
