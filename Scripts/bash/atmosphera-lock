#!/usr/bin/env -S bash
set -euo pipefail

QS_BIN="qs"

find_config() {
  [ -n "${ATMOSPHERA_CONFIG:-}" ] && { echo "$ATMOSPHERA_CONFIG"; return 0; }
  [ -d "$HOME/Projects/atmosphera" ] && { echo "$HOME/Projects/atmosphera"; return 0; }
  echo "/etc/xdg/quickshell/atmosphera"
}

ACTION="${1:-lock}"

usage() {
  echo "Usage: $0 [lock|preview|help]"
  echo ""
  echo "Commands:"
  echo "  lock      Lock the screen (default)"
  echo "  preview   Open lock screen in preview mode"
  echo "  help      Show this help"
  echo ""
  echo "Examples:"
  echo "  $0           # Lock the screen"
  echo "  $0 lock      # Lock the screen"
  echo "  $0 preview   # Preview lock screen"
}

case "$ACTION" in
  help|--help|-h) usage; exit 0 ;;
  lock)     exec "$QS_BIN" -p "$(find_config)" ipc call lockScreen lock ;;
  preview)  exec "$QS_BIN" -p "$(find_config)" ipc call lockScreen preview ;;
  *)        echo "Unknown action: $ACTION"; usage; exit 1 ;;
esac
