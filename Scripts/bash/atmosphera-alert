#!/bin/bash
set -euo pipefail

question="${1:?Usage: atmosphera-alert <message>}"

QS="${ATMOSPHERA_QS:-qs}"

source "$(dirname "$(readlink -f "$0")")/shell-owner.sh"
PID=$(shell_owner_require)

source "$(dirname "$(readlink -f "$0")")/dialog-reply.sh"
dialog_request alert "$question"
dialog_read || true
