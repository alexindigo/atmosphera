#!/bin/bash
set -euo pipefail

question="${1:?Usage: atmosphera-alert <message>}"

QS="${ATMOSPHERA_QS:-qs}"

source "$(dirname "$(readlink -f "$0")")/shell-owner.sh"
PID=$(shell_owner_require)

tmpdir=$(mktemp -d "${XDG_RUNTIME_DIR:-/dev/shm}/atmosphera-dialog-XXXXXX")
fifo="$tmpdir/reply"
mkfifo "$fifo"

cleanup() {
  timeout 5 "$QS" ipc --pid "$PID" call dialog cancel &>/dev/null || true
  rm -rf "$tmpdir"
}
trap cleanup EXIT INT TERM

timeout 5 "$QS" ipc --pid "$PID" call dialog alert "$question" "$fifo" &>/dev/null &

TIMEOUT="${ATMOSPHERA_DIALOG_TIMEOUT:-30}"
read -t "$TIMEOUT" result < "$fifo" 2>/dev/null || true
