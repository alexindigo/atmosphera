pragma Singleton

import QtQuick
import Quickshell
import "../../Helpers/OwnedProcess.js" as OwnedProcess
import qs.Commons
import qs.Services.Compositor
import qs.Services.UI

// Generates the input-method binds of the running compositor from
// Settings.data.inputMethod: the fcitx5 autostart and one bind per input-method
// switch and next-key combo. niri: ~/.config/niri/atmosphera-input.kdl (its session
// includes it). Hyprland: ~/.config/hypr/atmosphera-input.conf, plus
// atmosphera-input.lua on the Lua route. mangowc: ~/.config/mango/atmosphera-input.conf.
// Hyprland and mangowc are reloaded after a change. Key presses are handled by the
// shell's IPC (inputmethod toggleIM/setIM/next).
Singleton {
  id: root

  readonly property string xdgConfigHome: Quickshell.env("XDG_CONFIG_HOME") || Quickshell.env("HOME") + "/.config"
  readonly property string niriDir: root.xdgConfigHome + "/niri"
  readonly property string hyprDir: root.xdgConfigHome + "/hypr"
  readonly property string mangoDir: root.xdgConfigHome + "/mango"
  readonly property string headerText: "Generated by Atmosphera from Settings \u2192 Shortcuts. Do not edit."
  readonly property string header: "// " + root.headerText
  readonly property var _modifierOrder: ["Super", "Ctrl", "Alt", "Shift"]

  // Settings-derived key: changes whenever the generated file would change.
  readonly property string settingsKey: root._settingsKey()

  // combo (canonical) -> Atmosphera-owned niri file that already binds it.
  property var _owners: ({})
  // path -> content last written for it (only ever set after a successful write).
  property var _written: ({})
  property bool _writing: false
  property bool _dirty: false
  property int _serial: 0

  // Legacy atmosphera-i18n.kdl (see checkLegacy). The only shipped version is commit 95d03c3d5's.
  readonly property string i18nFile: root.niriDir + "/atmosphera-i18n.kdl"
  readonly property string _shippedI18nSha256: "1a6c4aeda09bc15264c7a4c2eb031659bbb100e79d686c9510dd50234a7fdb35"
  readonly property string _titlePrefix: "Input method: "
  // True while the legacy file is present and kept (not converted).
  property bool customI18nFile: false
  property bool _legacyBusy: false
  property int _legacyAttempts: 0

  readonly property string _legacyProbeScript: 'if [ -f "$1" ]; then printf "PRESENT "; sha256sum < "$1" | cut -d" " -f1; cat -- "$1"; else echo MISSING; fi'
  readonly property string _legacyBackupScript: 'set -eu\nmkdir -p "$2"\ncp -n -p "$1" "$2/$3"\n[ "$(sha256sum < "$1" | cut -d" " -f1)" = "$4" ]\n[ "$(sha256sum < "$2/$3" | cut -d" " -f1)" = "$4" ]\n'
  readonly property string _legacyRemoveScript: 'set -eu\n[ "$(sha256sum < "$1" | cut -d" " -f1)" = "$2" ]\nrm -f -- "$1"\n'

  readonly property string _probeScript: 'DIR="$1"; ROUTE="$2"; shift 2\n' + 'if command -v fcitx5 >/dev/null 2>&1; then echo "FCITX5 yes"; else echo "FCITX5 no"; fi\n' + 'if [ -n "$ROUTE" ] && [ -f "$DIR/$ROUTE" ]; then echo "ROUTE yes"; fi\n' + 'for NAME in "$@"; do\n'
                                         + '  if [ -f "$DIR/$NAME" ]; then echo "@@FILE $NAME"; cat "$DIR/$NAME"; printf "\\n@@END\\n"; fi\n' + 'done\n'
  // Arguments: the directory, then (path, temporary, content) per file: each content goes to its temporary
  // file, which is moved over its path. One process writes all files of a run (the timing rule is 1 s).
  readonly property string _writeScript: 'set -eu\numask 077\nDIR="$1"; shift\nmkdir -p "$DIR"\nwhile [ $# -ge 3 ]; do\n  printf \'%s\' "$3" > "$2"\n  mv -f "$2" "$1"\n  shift 3\ndone\n'

  function init() {
    root.schedule();
    root.checkLegacy();
  }

  // Debounced regeneration for settings and fcitx5 changes.
  function schedule() {
    debounce.restart();
  }

  // Immediate regeneration, serialized: a request during a run is replayed after it.
  function regenerate() {
    var dialect = root._dialect();
    if (!dialect)
      return;
    if (root._writing) {
      root._dirty = true;
      return;
    }
    root._writing = true;
    root._dirty = false;
    var finish = function () {
      root._writing = false;
      if (root._dirty)
        root.regenerate();
    };
    try {
      var probeArgs = ["sh", "-c", root._probeScript, "sh", dialect.dir, dialect.route].concat(dialect.owned);
      if (dialect.name === "Hyprland")
        probeArgs = ["bash", "-c", 'set -eu\nsource "$1"\nhypr_config_resolve\nshift\nprintf "@@DIR %s\\n" "$HYPR_CONFIG_DIR"\nif [ "$HYPR_CONFIG_LANGUAGE" = lua ]; then echo "ROUTE yes"; fi\nset -- "$HYPR_CONFIG_DIR" "" "$@"\n' + root._probeScript, "bash", Quickshell.shellDir + "/Scripts/bash/hypr-config-resolve.sh"].concat(dialect.owned);
      OwnedProcess.run(root, probeArgs, null, function (probe) {
        if (!probe.success) {
          Logger.w("InputMethodBinds", "could not read", dialect.name, "files; input bindings not updated", probe.error);
          finish();
          return;
        }
        var parsed = root._parseProbe(probe.stdout);
        if (dialect.name === "Hyprland")
          dialect.dir = parsed.dir;
        root._owners = root._ownersOf(parsed.files, dialect);
        var plan = root._plan(parsed.fcitx5, dialect.plain);
        var pending = [];
        dialect.outputs(plan, parsed.route).forEach(function (out) {
          var path = dialect.dir + "/" + out.name;
          if (root._written[path] !== out.content)
            pending.push({
                           "path": path,
                           "content": out.content
                         });
        });
        root._writeAll(dialect, pending, finish);
      });
    } catch (error) {
      Logger.w("InputMethodBinds", "regeneration could not start");
      finish();
    }
  }

  // Writes the changed files in one process (a temporary file per file, then mv). The compositor is
  // reloaded once after a successful write.
  function _writeAll(dialect, pending, done) {
    if (pending.length === 0) {
      done();
      return;
    }
    var argv = ["sh", "-c", root._writeScript, "sh", dialect.dir];
    for (var i = 0; i < pending.length; i++)
      argv.push(pending[i].path, pending[i].path + ".tmp-" + (++root._serial), pending[i].content);
    OwnedProcess.run(root, argv, null, function (written) {
      if (!written.success) {
        Logger.w("InputMethodBinds", "write failed", dialect.dir, written.error || written.stderr);
        done();
        return;
      }
      for (var j = 0; j < pending.length; j++)
        root._written[pending[j].path] = pending[j].content;
      root._reload(dialect);
      done();
    });
  }

  function _reload(dialect) {
    if (!dialect.reload)
      return;
    OwnedProcess.run(root, dialect.reload, null, function (reloaded) {
      if (reloaded.success)
        Logger.i("InputMethodBinds", "reloaded", dialect.name, "config");
      else
        Logger.w("InputMethodBinds", dialect.name, "reload failed", reloaded.error || reloaded.stderr);
    });
  }

  // Which Atmosphera-owned file binds `combo`, or "" when it is free.
  function conflictFor(combo) {
    return root._owners[root._canonical(String(combo))] || "";
  }

  // ——— Compositor dialects ———

  // The running compositor's file layout and syntax, or null when it has no input-method binds.
  //   dir      config directory; owned: Atmosphera-owned files there that may bind a combo
  //   route    optional route-file probe; Hyprland resolves language/directory in its shared helper
  //   plain    the syntax cannot escape a comma or blank: such combos and targets are refused
  //   reload   argv run after a change, or null (niri watches its session include)
  //   combos   (name, text) -> canonical combos bound in an owned file
  //   outputs  (plan, routed) -> [{name, content}] for the files this compositor reads
  function _dialect() {
    if (CompositorService.isNiri) {
      var owned = ["atmosphera.kdl", "atmosphera-i18n.kdl"];
      if (String(Settings.data.bindings.environment || "none") === "macos")
        owned.push("atmosphera-shortcuts-macos.kdl");
      return {
        "name": "niri",
        "dir": root.niriDir,
        "owned": owned,
        "route": "",
        "plain": false,
        "reload": null,
        "combos": function (name, text) {
          return root._bindCombos(text);
        },
        "outputs": function (plan) {
          return [
                {
                  "name": "atmosphera-input.kdl",
                  "content": root._renderKdl(plan)
                }
              ];
        }
      };
    }
    if (CompositorService.isHyprland) {
      return {
        "name": "Hyprland",
        "dir": root.hyprDir,
        "owned": ["atmosphera.conf", "atmosphera.lua"],
        "route": "",
        "plain": true,
        "reload": ["hyprctl", "reload"],
        "combos": function (name, text) {
          return name.slice(-4) === ".lua" ? root._luaCombos(text) : root._hyprlangCombos(text);
        },
        "outputs": function (plan, routed) {
          var files = [
                {
                  "name": "atmosphera-input.conf",
                  "content": root._renderHyprlang(plan)
                }
              ];
          if (routed)
            files.push({
                         "name": "atmosphera-input.lua",
                         "content": root._renderLua(plan)
                       });
          return files;
        }
      };
    }
    if (CompositorService.isMango) {
      return {
        "name": "mangowc",
        "dir": root.mangoDir,
        "owned": ["atmosphera.conf"],
        "route": "",
        "plain": true,
        "reload": ["mmsg", "dispatch", "reload_config"],
        "combos": function (name, text) {
          return root._mangoCombos(text);
        },
        "outputs": function (plan) {
          return [
                {
                  "name": "atmosphera-input.conf",
                  "content": root._renderMango(plan)
                }
              ];
        }
      };
    }
    return null;
  }

  // ——— Rendering ———

  // The binds the settings ask for: {fcitx5: bool, binds: [{combo, title, args}]}.
  // Nothing when fcitx5 is not installed (the header-only file). plain: a comma or
  // blank in a combo or target is refused (logged), since the syntax cannot escape it.
  function _plan(installed, plain) {
    var plan = {
      "fcitx5": false,
      "binds": []
    };
    if (!installed)
      return plan;
    var im = Settings.data.inputMethod;
    var claimed = {};
    plan.fcitx5 = !!im.launchFcitx5;
    for (var i = 0; i < im.switches.length; i++) {
      var sw = im.switches[i];
      var refusal = InputMethodService.validateSwitch(sw);
      if (refusal) {
        Logger.w("InputMethodBinds", "skipped switch", i, refusal);
        continue;
      }
      if (plain && /[\s,]/.test(String(sw.target))) {
        Logger.w("InputMethodBinds", "skipped switch", i, "- target has a comma or blank");
        continue;
      }
      var verb = sw.mode === "set" ? "setIM" : "toggleIM";
      var title = "Input method: " + root._labelFor(sw);
      var args = ["atmosphera", "ipc", "inputmethod", verb, String(sw.target)];
      root._addBinds(plan.binds, claimed, sw.keys, title, args, "switch " + sw.target, plain);
    }
    for (var n = 0; n < im.nextKeys.length; n++) {
      var combo = im.nextKeys[n];
      var comboRefusal = InputMethodService.validateCombo(combo);
      if (comboRefusal) {
        Logger.w("InputMethodBinds", "skipped next key", n, comboRefusal);
        continue;
      }
      root._addBinds(plan.binds, claimed, [combo], "Input method: next", ["atmosphera", "ipc", "inputmethod", "next"], "next key", plain);
    }
    return plan;
  }

  // Adds one bind per combo of a switch, or none when any combo is refused:
  // the switch is skipped as a whole, each refused combo logged.
  function _addBinds(binds, claimed, combos, title, args, what, plain) {
    var found = [];
    var seen = {};
    for (var j = 0; j < combos.length; j++) {
      var combo = String(combos[j]);
      var canonical = root._canonical(combo);
      var owner = root._owners[canonical];
      if (owner) {
        Logger.w("InputMethodBinds", "skipped", what, "- " + combo + " is already bound in " + owner);
        return;
      }
      if (claimed[canonical] || seen[canonical]) {
        Logger.w("InputMethodBinds", "skipped", what, "- " + combo + " is already used by another switch");
        return;
      }
      if (plain && /[\s,]/.test(combo)) {
        Logger.w("InputMethodBinds", "skipped", what, "- " + combo + " has a comma or blank");
        return;
      }
      seen[canonical] = true;
      found.push({
                   "combo": combo,
                   "title": title,
                   "args": args
                 });
    }
    for (var c in seen)
      claimed[c] = true;
    for (var p = 0; p < found.length; p++)
      binds.push(found[p]);
  }

  // niri KDL: no repeat, works while locked, titled.
  function _renderKdl(plan) {
    var out = [root.header];
    if (plan.fcitx5)
      out.push('spawn-at-startup "fcitx5"');
    if (plan.binds.length > 0) {
      out.push("binds {");
      for (var b = 0; b < plan.binds.length; b++) {
        var bind = plan.binds[b];
        out.push("    " + bind.combo + ' repeat=false allow-when-locked=true hotkey-overlay-title=' + root._kdl(bind.title) + ' { spawn ' + bind.args.map(root._kdl).join(" ") + "; }");
      }
      out.push("}");
    }
    return out.join("\n") + "\n";
  }

  // Hyprland hyprlang: bindld = no repeat (no "e"), works while locked ("l"), titled ("d").
  function _renderHyprlang(plan) {
    var out = ["# " + root.headerText];
    if (plan.fcitx5)
      out.push("exec-once = fcitx5");
    for (var b = 0; b < plan.binds.length; b++) {
      var bind = plan.binds[b];
      out.push("bindld = " + root._modsOf(bind.combo, " ") + ", " + root._keyOf(bind.combo) + ", " + root._plain(bind.title) + ", exec, " + bind.args.join(" "));
    }
    return out.join("\n") + "\n";
  }

  // Hyprland Lua (Hyprland >= 0.55): locked, not repeating, titled through description.
  function _renderLua(plan) {
    var out = ["-- " + root.headerText];
    if (plan.fcitx5)
      out.push('hl.on("hyprland.start", function() hl.exec_cmd("fcitx5") end)');
    for (var b = 0; b < plan.binds.length; b++) {
      var bind = plan.binds[b];
      out.push("hl.bind(" + root._lua(root._modsOf(bind.combo, " + ", root._keyOf(bind.combo))) + ", hl.dsp.exec_cmd(" + root._lua(bind.args.join(" ")) + "), { locked = true, repeating = false, description = " + root._lua(bind.title) + " })");
    }
    return out.join("\n") + "\n";
  }

  // mangowc: bindl = works while locked; mangowc binds take no description, so titles are
  // not written (the header says so).
  function _renderMango(plan) {
    var out = ["# " + root.headerText, "# mangowc binds have no description: switch titles are not written."];
    if (plan.fcitx5)
      out.push("exec-once=fcitx5");
    for (var b = 0; b < plan.binds.length; b++) {
      var bind = plan.binds[b];
      var mods = root._parts(bind.combo).mods;
      out.push("bindl=" + (mods.length ? mods.map(root._upper).join("+") : "NONE") + "," + root._keyOf(bind.combo) + ",spawn," + bind.args.join(" "));
    }
    return out.join("\n") + "\n";
  }

  // Modifiers of a canonical combo as the syntax spells them, joined by `sep`, then the key
  // (`key` argument, or none). Empty when the combo has no modifier.
  function _modsOf(combo, sep, key) {
    var parts = root._parts(combo).mods.map(root._upper).join(sep);
    if (key === undefined)
      return parts;
    return parts === "" ? key : parts + sep + key;
  }

  function _keyOf(combo) {
    return root._parts(combo).key;
  }

  // {mods: [...], key} of a canonical combo ("Super+Alt+J").
  function _parts(combo) {
    var parts = String(combo).split("+");
    var key = parts.pop();
    return {
      "mods": parts,
      "key": key
    };
  }

  function _upper(text) {
    return String(text).toUpperCase();
  }

  // Lua string literal.
  function _lua(text) {
    return '"' + String(text).replace(/\\/g, "\\\\").replace(/"/g, '\\"').replace(/[\r\n]/g, " ") + '"';
  }

  // Text for a comma-separated hyprlang field: commas and line breaks become blanks.
  function _plain(text) {
    return String(text).replace(/[,\r\n]/g, " ");
  }

  function _labelFor(sw) {
    if (sw.label)
      return String(sw.label);
    var found = InputMethodService.availableIMs.find(function (im) {
      return im.uniqueName === sw.target;
    });
    return found && found.name ? found.name : String(sw.target);
  }

  // KDL double-quoted string.
  function _kdl(text) {
    return '"' + String(text).replace(/\\/g, "\\\\").replace(/"/g, '\\"').replace(/[\r\n]/g, " ") + '"';
  }

  // Modifiers in fixed order, then the key: "Alt+Super+K" and "Super+Alt+K" are one combo.
  function _canonical(combo) {
    var parts = combo.split("+");
    var key = parts.pop();
    var order = root._modifierOrder;
    parts.sort(function (a, b) {
      var ia = order.indexOf(a) < 0 ? order.length : order.indexOf(a);
      var ib = order.indexOf(b) < 0 ? order.length : order.indexOf(b);
      return ia - ib;
    });
    parts.push(key);
    return parts.join("+");
  }

  // ——— Owned niri files ———

  // Output of the probe: "FCITX5 yes|no", "ROUTE yes" for Lua, optional "@@DIR <path>",
  // then "@@FILE <name>" ... "@@END" blocks.
  function _parseProbe(stdout) {
    var result = {
      "fcitx5": false,
      "route": false,
      "dir": "",
      "files": {}
    };
    var lines = String(stdout || "").split("\n");
    var current = null;
    for (var i = 0; i < lines.length; i++) {
      var line = lines[i];
      if (current === null) {
        if (line === "FCITX5 yes")
          result.fcitx5 = true;
        else if (line === "ROUTE yes")
          result.route = true;
        else if (line.indexOf("@@DIR ") === 0)
          result.dir = line.substring(6);
        else if (line.indexOf("@@FILE ") === 0)
          current = {
            "name": line.substring(7),
            "lines": []
          };
        continue;
      }
      if (line === "@@END") {
        result.files[current.name] = current.lines.join("\n");
        current = null;
      } else {
        current.lines.push(line);
      }
    }
    return result;
  }

  function _ownersOf(files, dialect) {
    var owners = {};
    for (var name in files) {
      var combos = dialect.combos(name, files[name]);
      for (var i = 0; i < combos.length; i++) {
        if (!owners[combos[i]])
          owners[combos[i]] = name;
      }
    }
    return owners;
  }

  // Canonical combo from modifier names as the compositors spell them (SUPER, CTRL, MOD1, ...)
  // and a key. Unknown modifiers are kept as written; they match nothing.
  function _comboOf(mods, key) {
    var names = [];
    for (var i = 0; i < mods.length; i++) {
      var raw = String(mods[i]).trim();
      var m = raw.toUpperCase();
      if (m === "" || m === "NONE")
        continue;
      if (m === "SUPER" || m === "MOD4" || m === "WIN" || m === "LOGO")
        names.push("Super");
      else if (m === "CTRL" || m === "CONTROL")
        names.push("Ctrl");
      else if (m === "ALT" || m === "MOD1")
        names.push("Alt");
      else if (m === "SHIFT")
        names.push("Shift");
      else
        names.push(raw);
    }
    names.push(String(key).trim());
    return root._canonical(names.join("+"));
  }

  // hyprlang: "bind[flags] = MODS, KEY, ..." (MODS space-separated, possibly empty).
  function _hyprlangCombos(text) {
    var combos = [];
    var lines = String(text).split("\n");
    for (var i = 0; i < lines.length; i++) {
      var m = /^\s*bind[a-z]*\s*=\s*([^,]*),\s*([^,]+?)\s*(,|$)/.exec(lines[i].replace(/#.*$/, ""));
      if (m)
        combos.push(root._comboOf(m[1].split(/[\s_+]+/), m[2]));
    }
    return combos;
  }

  // Lua: hl.bind("MODS + KEY", ...) in the first argument.
  function _luaCombos(text) {
    var combos = [];
    var lines = String(text).split("\n");
    for (var i = 0; i < lines.length; i++) {
      var m = /hl\.bind\(\s*"([^"]+)"/.exec(lines[i].replace(/--.*$/, ""));
      if (m) {
        var parts = m[1].split("+");
        var key = parts.pop();
        combos.push(root._comboOf(parts, key));
      }
    }
    return combos;
  }

  // mangowc: "bind[flags]=MODS,KEY,..." (MODS "+"-joined, "NONE" for none).
  function _mangoCombos(text) {
    var combos = [];
    var lines = String(text).split("\n");
    for (var i = 0; i < lines.length; i++) {
      var m = /^\s*bind[a-z]*\s*=\s*([^,]*),\s*([^,]+?)\s*(,|$)/.exec(lines[i].replace(/#.*$/, ""));
      if (m)
        combos.push(root._comboOf(m[1].split("+"), m[2]));
    }
    return combos;
  }

  // Key combos of the top-level entries of every `binds { }` block in a KDL text.
  // Brace depth is tracked line by line; a `//` comment ends a line's content.
  function _bindCombos(text) {
    var combos = [];
    var depth = 0;
    var inside = -1;
    var lines = String(text).split("\n");
    for (var i = 0; i < lines.length; i++) {
      var line = lines[i].replace(/\/\/.*$/, "");
      var opening = depth;
      if (inside < 0 && opening === 0 && /^\s*binds\s*\{/.test(line))
        inside = 1;
      else if (inside >= 0 && opening === inside) {
        var m = /^\s*([A-Za-z0-9_+]+)(?=\s|\{|;|$)/.exec(line);
        if (m)
          combos.push(root._canonical(m[1]));
      }
      for (var c = 0; c < line.length; c++) {
        if (line[c] === "{")
          depth++;
        else if (line[c] === "}")
          depth--;
      }
      if (inside >= 0 && depth < inside)
        inside = -1;
    }
    return combos;
  }

  // ——— Legacy atmosphera-i18n.kdl ———
  //
  // 0.8.0 shipped this file with the Alt+Space and Ctrl+Space switches. Once
  // fcitx5's lists are loaded, a start with legacyI18nChecked unset either
  // converts the shipped file (identical bytes, no switches yet) into switches,
  // or keeps any other file untouched. The flag is then set. customI18nFile
  // reports a kept file on every start.

  // Runs the one-time check. No-op outside niri and while a run is in flight.
  function checkLegacy() {
    if (!CompositorService.isNiri || root._legacyBusy)
      return;
    root._legacyBusy = true;
    InputMethodService.whenListsReady(function (listError) {
      if (listError) {
        // fcitx5 absent or lists timed out: the next list change runs the check.
        root._legacyBusy = false;
        return;
      }
      root._readLegacy(function (state) {
        var im = Settings.data.inputMethod;
        if (state.error) {
          Logger.w("InputMethodBinds", "legacy i18n file not read:", state.error);
          root._legacyBusy = false;
        } else if (state.missing) {
          root.customI18nFile = false;
          root._legacyBusy = false;
        } else if (!im.legacyI18nChecked && state.sha256 === root._shippedI18nSha256 && im.switches.length === 0) {
          root._convertLegacy(state, function (error) {
            root._legacyBusy = false;
            if (!error) {
              root._legacyAttempts = 0;
            } else {
              Logger.w("InputMethodBinds", "legacy i18n conversion failed:", error);
              if (root._legacyAttempts < 5) {
                root._legacyAttempts++;
                legacyRetry.restart();
              }
            }
          });
        } else {
          // Hand-edited, or shipped with switches already: kept as it is.
          if (!im.legacyI18nChecked)
            im.legacyI18nChecked = true;
          root.customI18nFile = true;
          Logger.i("InputMethodBinds", "legacy i18n file kept, not converted:", root.i18nFile);
          root._legacyBusy = false;
        }
      });
    });
  }

  // Converts the shipped file: each bind whose target would work becomes a switch;
  // the others are logged and named once in a notice. done(error).
  function _convertLegacy(state, done) {
    var added = [];
    var refused = [];
    root._legacyBinds(state.content).forEach(function (sw) {
      var refusal = InputMethodService.validateSwitch(sw) || InputMethodService.switchRefusal(sw.target);
      if (refusal) {
        Logger.w("InputMethodBinds", "legacy i18n bind not converted:", sw.keys[0], "-", refusal);
        refused.push(sw.target);
      } else {
        added.push(sw);
      }
    });
    root._retire(state, added, function (error) {
      if (!error && refused.length > 0) {
        var names = refused.join(", ");
        Logger.i("InputMethodBinds", "legacy i18n notice shown; not converted:", names);
        ToastService.showNotice(I18n.tr("toast.legacy-i18n.title"), I18n.tr("toast.legacy-i18n.skipped", {
                                                                              "targets": names
                                                                            }));
      }
      done(error);
    });
  }

  // Imports the binds of a hand-edited legacy file as switches, skipping combos a
  // switch already holds. The file is retired as in _convertLegacy.
  // done(count, error): count switches added; on error nothing has changed.
  function importLegacyI18n(done) {
    if (root._legacyBusy) {
      done(0, "another legacy i18n update is running");
      return;
    }
    root._legacyBusy = true;
    var finish = function (count, error) {
      root._legacyBusy = false;
      done(count, error);
    };
    root._readLegacy(function (state) {
      if (state.error) {
        finish(0, state.error);
        return;
      }
      if (state.missing) {
        finish(0, "no legacy i18n file at " + root.i18nFile);
        return;
      }
      var im = Settings.data.inputMethod;
      var known = {};
      for (var i = 0; i < im.switches.length; i++) {
        var keys = im.switches[i] && im.switches[i].keys ? im.switches[i].keys : [];
        for (var k = 0; k < keys.length; k++)
          known[root._canonical(String(keys[k]))] = true;
      }
      var parsed = root._legacyBinds(state.content);
      var added = [];
      var skipped = [];
      parsed.forEach(function (sw) {
        var combo = root._canonical(String(sw.keys[0]));
        if (InputMethodService.validateSwitch(sw))
          skipped.push(sw.keys[0] + " (invalid)");
        else if (known[combo])
          skipped.push(sw.keys[0] + " (already a switch)");
        else {
          known[combo] = true;
          added.push(sw);
        }
      });
      if (parsed.length === 0) {
        finish(0, "no input-method bind found in " + root.i18nFile);
        return;
      }
      if (added.length === 0) {
        finish(0, "no bind could be imported: " + skipped.join(", "));
        return;
      }
      root._retire(state, added, function (error) {
        if (error) {
          finish(0, error);
          return;
        }
        if (skipped.length > 0)
          Logger.w("InputMethodBinds", "legacy i18n import skipped:", skipped.join(", "));
        finish(added.length, "");
      });
    });
  }

  // Stores `added` as switches, then retires the file: the session is regenerated
  // without the include first, then the file is backed up and removed. done(error).
  // On error the file stays where it is.
  function _retire(state, added, done) {
    // The file belongs to niri's config directory: without a niri session nothing is retired.
    if (!CompositorService.isNiri) {
      done("not running under niri; legacy i18n file left in place");
      return;
    }
    var environment = String(Settings.data.bindings.environment || "none");
    var backups = Settings.configDir + "backups";
    var stamp = Qt.formatDateTime(new Date(), "yyyyMMdd-hhmmss");
    var backup = backups + "/atmosphera-i18n.kdl." + stamp;
    var abort = function (error) {
      NiriSessionInit.excludeI18n = false;
      done(error);
    };
    NiriSessionInit.excludeI18n = true;
    NiriSessionInit.regenerate(environment, function (success, error) {
      if (!success) {
        abort("session without the legacy include was not applied: " + error);
        return;
      }
      OwnedProcess.run(root, ["sh", "-c", root._legacyBackupScript, "sh", root.i18nFile, backups, "atmosphera-i18n.kdl." + stamp, state.sha256], null, function (copied) {
        if (!copied.success) {
          abort("legacy i18n backup failed: " + copied.error);
          return;
        }
        var im = Settings.data.inputMethod;
        var merged = [];
        for (var i = 0; i < im.switches.length; i++)
          merged.push(im.switches[i]);
        im.switches = merged.concat(added);
        im.legacyI18nChecked = true;
        OwnedProcess.run(root, ["sh", "-c", root._legacyRemoveScript, "sh", root.i18nFile, state.sha256], null, function (removed) {
          NiriSessionInit.excludeI18n = false;
          if (!removed.success) {
            done("legacy i18n file not removed: " + removed.error);
            return;
          }
          root.customI18nFile = false;
          Logger.i("InputMethodBinds", "legacy i18n file retired; backup at", backup, "- switches added:", added.length);
          root.schedule();
          done("");
        });
      });
    });
  }

  // done({missing: true} | {sha256, content} | {error}) for the legacy file.
  function _readLegacy(done) {
    OwnedProcess.run(root, ["sh", "-c", root._legacyProbeScript, "sh", root.i18nFile], null, function (probe) {
      if (!probe.success) {
        done({
               "error": probe.error || "probe failed"
             });
        return;
      }
      var text = String(probe.stdout || "");
      var newline = text.indexOf("\n");
      var head = newline < 0 ? text : text.substring(0, newline);
      if (head === "MISSING") {
        done({
               "missing": true
             });
        return;
      }
      if (head.indexOf("PRESENT ") !== 0) {
        done({
               "error": "unexpected probe output"
             });
        return;
      }
      done({
             "sha256": head.substring(8),
             "content": newline < 0 ? "" : text.substring(newline + 1)
           });
    });
  }

  // Input-method binds of a legacy file, in file order: [{keys, target, mode, label}].
  // A bind is one entry whose spawn is `atmosphera ipc inputmethod toggleIM|setIM <target> [group]`;
  // the label is its hotkey-overlay-title without the generator's "Input method: " prefix.
  function _legacyBinds(text) {
    var out = [];
    var re = /^[ \t]*([A-Za-z0-9_+]+)[ \t]+([^\n{]*)\{[ \t]*\n?[ \t]*spawn[ \t]+"atmosphera"[ \t]+"ipc"[ \t]+"inputmethod"[ \t]+"(toggleIM|setIM)"[ \t]+"([^"\n]+)"[^;\n]*;[ \t]*\n?[ \t]*\}/gm;
    var m;
    while ((m = re.exec(String(text || ""))) !== null) {
      var title = /hotkey-overlay-title="([^"\n]*)"/.exec(m[2]);
      var label = title ? title[1] : "";
      if (label.indexOf(root._titlePrefix) === 0)
        label = label.substring(root._titlePrefix.length);
      out.push({
                 "keys": [m[1]],
                 "target": m[4],
                 "mode": m[3] === "setIM" ? "set" : "toggle",
                 "label": label
               });
    }
    return out;
  }

  // ——— Settings snapshot ———

  function _settingsKey() {
    var im = Settings.data.inputMethod;
    var parts = [String(Settings.data.bindings.environment), String(im.launchFcitx5)];
    for (var i = 0; i < im.switches.length; i++) {
      var sw = im.switches[i] || {};
      var keys = [];
      var list = sw.keys || [];
      for (var k = 0; k < list.length; k++)
        keys.push(String(list[k]));
      parts.push([keys.join(" "), String(sw.target), String(sw.mode), String(sw.label)].join("\u0001"));
    }
    parts.push("|next");
    for (var n = 0; n < im.nextKeys.length; n++)
      parts.push(String(im.nextKeys[n]));
    return parts.join("\u0002");
  }

  onSettingsKeyChanged: {
    Logger.i("InputMethodBinds", "settings changed; regenerating");
    root.schedule();
  }

  Connections {
    target: InputMethodService
    function onFcitx5AvailableChanged() {
      root.schedule();
    }
    function onAvailableIMsChanged() {
      root.schedule();
      root.checkLegacy();
    }
  }

  Timer {
    id: debounce
    interval: 300
    onTriggered: root.regenerate()
  }

  // Retries a legacy conversion that failed (session busy or handoff refused).
  Timer {
    id: legacyRetry
    interval: 1000
    onTriggered: root.checkLegacy()
  }
}
