pragma Singleton
pragma ComponentBehavior: Bound
import ImvQml

import QtQuick
import Quickshell
import "../../Helpers/ImageTypes.js" as ImageTypes
import "../../Helpers/PortalPaths.js" as PortalPaths
import qs.Commons

Singleton {
  id: root
  property bool initialized: false
  property int _sequence: 0
  property var _notificationDownloads: ({})
  property var _cacheClears: new Map()
  readonly property string baseDir: Settings.cacheDir + "images/"
  readonly property string notificationsDir: baseDir + "notifications/"
  readonly property string videoFramesDir: baseDir + "video-wallpapers/"
  readonly property string thumbnailDir: (Quickshell.env("XDG_CACHE_HOME") || Quickshell.env("HOME") + "/.cache") + "/thumbnails/"
  readonly property var basicImageFilters: ImageTypes.filters
  readonly property var imageFilters: ImageTypes.filters

  signal representationsCleared(int ticket, var result)

  function init() {
    ImvCache.directory = baseDir + "decoded/";
    ImvCache.enabled = true;
    originals.ensureStage();
    initialized = true;
  }

  function isGeneratedImage(path) {
    // Include paths generated by older releases so a saved thumbnail is not
    // mistaken for a permanent wallpaper after the decoder migration.
    const local = String(path || "").replace(/^file:\/\//, "");
    return local !== "" && !local.includes("/../") && [thumbnailDir, baseDir + "wallpapers/", baseDir + "decoded/", videoFramesDir].some(dir => local.startsWith(dir));
  }

  function clearRepresentations(callback) {
    const ticket = ImvCache.clear();
    if (ticket > 0)
      _cacheClears.set(ticket, callback);
    else
      callback?.({
                   ok: false,
                   reason: "Cache clear could not be queued"
                 });
  }

  Connections {
    target: ImvCache
    function onCleared(ticket, result) {
      if (!root._cacheClears.has(ticket))
        return;
      const callback = root._cacheClears.get(ticket);
      root._cacheClears.delete(ticket);
      root.representationsCleared(ticket, result);
      const outcome = {
        ok: result.stage === "complete" && result.failed === 0,
        reason: result.detail || result.code,
        removed: result.removed,
        kept: result.kept,
        failed: result.failed
      };
      if (!outcome.ok) {
        callback?.(outcome);
        return;
      }
      originals.clearLegacyRepresentations(reply => {
        if (!reply.ok) {
          outcome.ok = false;
          outcome.reason = "Could not clear legacy image representations";
        }
        callback?.(outcome);
      });
    }
  }

  function openNotificationHistory(history, callback) {
    originals.open(notificationsDir + "retained/", history, callback);
  }

  function updateNotificationHolders(paths, rows, callback) {
    originals.update(paths, rows, callback);
  }

  function getNotificationIcon(source, callback) {
    // Local and provider captures must be fresh at every producer event. A
    // remote locator, in contrast, can share the same in-flight acquisition.
    if (!/^https?:\/\//i.test(source))
      return retainImage(source, notificationsDir + "retained/", callback, true);
    let entry = _notificationDownloads[source];
    if (!entry) {
      entry = {
        listeners: new Set(),
        request: null
      };
      _notificationDownloads[source] = entry;
      entry.request = retainImage(source, notificationsDir + "retained/", (path, ok, detail) => {
        if (_notificationDownloads[source] === entry)
          delete _notificationDownloads[source];
        for (const listener of entry.listeners)
          listener(path, ok, detail);
        entry.listeners.clear();
      }, true);
    }
    entry.listeners.add(callback);
    return {
      cancel: () => {
        if (!entry.listeners.delete(callback) || entry.listeners.size)
          return;
        if (_notificationDownloads[source] === entry) {
          delete _notificationDownloads[source];
          entry.request.cancel();
        }
      }
    };
  }

  function retainImage(source, directory, callback, notification = false) {
    const request = retention.createObject(root, {
                                             source: String(source),
                                             destinationDirectory: String(directory),
                                             completed: callback,
                                             key: String(++_sequence),
                                             notification: notification,
                                             store: originals
                                           });
    request.begin();
    return request;
  }

  function validateLocalImage(source, callback) {
    return validationComponent.createObject(root, {
                                              source: String(source),
                                              completed: callback
                                            });
  }

  // Video wallpaper integrations need a real path to assign to WallpaperService.
  // Display-only delegates should open the video itself through NImage.
  function exportVideoFrame(source, callback) {
    const request = retention.createObject(root, {
                                             source: String(source),
                                             destinationDirectory: videoFramesDir,
                                             completed: callback,
                                             key: String(++_sequence),
                                             notification: false,
                                             store: originals,
                                             videoFrame: true
                                           });
    request.begin();
    return request;
  }

  ImageOriginalStore {
    id: originals
  }
  Component {
    id: retention
    ImageRetention {}
  }

  // Local wallpaper admission validates a decodable frame without exporting
  // a representation. Keep the actual user-selected file in settings.
  Component {
    id: validationComponent
    Scope {
      id: validation
      required property string source
      required property var completed
      readonly property var local: source.startsWith("/") ? PortalPaths.pathToUri(source) : PortalPaths.uriToPath(source)
      property int ticket: 0
      property bool retired: false
      property int backoff: 25

      function cancel() {
        retired = true;
        wait.stop();
        if (ticket > 0)
          job.cancel(ticket);
        ticket = 0;
        destroy();
      }
      function submit() {
        if (retired)
          return;
        const url = local.ok ? local.uri || PortalPaths.pathToUri(local.path).uri : "";
        if (!url) {
          finish("", {
                   code: "invalid-source",
                   reason: "Wallpaper must be a local file"
                 });
          return;
        }
        ticket = job.sample(url, 1, 1, 0.1);
        if (ticket === -2) {
          wait.interval = backoff;
          backoff = Math.min(500, backoff * 2);
          wait.start();
        } else if (ticket <= 0) {
          finish("", {
                   code: "admission-rejected",
                   reason: "Could not submit the wallpaper for validation"
                 });
        }
      }
      function finish(path, result) {
        retired = true;
        ticket = 0;
        try {
          completed(path, !!path, result);
        } finally {
          destroy();
        }
      }
      ImvImageJob {
        id: job
        onFinished: (id, result) => {
          if (validation.retired || id !== validation.ticket)
            return;
          if (result.stage !== "complete") {
            validation.finish("", {
                                code: result.code,
                                reason: result.detail || result.code
                              });
            return;
          }
          validation.finish(validation.local.path || validation.source, result.sourceInfo);
        }
      }
      Timer {
        id: wait
        interval: 0
        onTriggered: validation.submit()
      }
      Component.onCompleted: wait.start()
    }
  }
}
